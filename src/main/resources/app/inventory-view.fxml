<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" spacing="12.0" styleClass="root-wallpaper" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.InventoryController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label alignment="CENTER" styleClass="title-banner" stylesheets="@style.css" text="Ingredient Inventory">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TableView fx:id="tblInventory" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colName" prefWidth="75.0" text="Ingredient" />
          <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
            <TableColumn fx:id="colPrice" prefWidth="75.0" text="Price" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefWidth="200.0" spacing="10.0">
         <children>
            <TextField fx:id="txtName" promptText="Ingredient Name" />
            <TextField fx:id="txtStock" promptText="Stock" />
            <TextField fx:id="txtPrice" promptText="Price" />
            <ComboBox fx:id="cmbIngredientType" prefWidth="150.0" />
         </children></HBox>
      <HBox alignment="CENTER" prefWidth="200.0" spacing="8.0">
         <children>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAddIngredient" styleClass="sandwich-btn" text="Add Ingredients">
               <font>
                  <Font size="10.0" />
               </font></Button>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleUpdateIngredient" styleClass="sandwich-btn" text="Update Selected">
               <font>
                  <Font size="10.0" />
               </font></Button>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleDeleteIngredient" styleClass="sandwich-btn" text="Delete Selected">
               <font>
                  <Font size="10.0" />
               </font></Button>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleBackToMenu" styleClass="sandwich-btn" text="Back to Menu">
               <font>
                  <Font size="10.0" />
               </font></Button>
         </children>
      </HBox>
   </children>
</VBox>
